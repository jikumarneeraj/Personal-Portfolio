# Google Gemini API Key (Required)
GEMINI_API_KEY=

# Gemini Model Selection (Optional, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# LangSmith Tracing & Observability (Optional, recommended)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neeraj-portfolio-chatbot

# Allowed Frontend Origins for CORS (comma-separated or single URL)
FRONTEND_URL=https://personal-portfolio-1-uo2v.onrender.com

# Server Port
PORT=8000
